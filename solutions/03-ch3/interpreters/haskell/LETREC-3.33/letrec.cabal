cabal-version: 3.0

name: letrec
version: 0.1.0.0

library
  default-language: Haskell2010
  hs-source-dirs: src

  exposed-modules:
    Letrec.Interpreter

  other-modules:
    Letrec.AST
    Letrec.Env
    Letrec.Parser

  build-depends:
    base,
    parsec

test-suite tests
  default-language: Haskell2010
  hs-source-dirs: tests

  type: exitcode-stdio-1.0
  main-is: Main.hs

  other-modules:
    Test.Interpreter

  build-depends:
    base,
    hspec,
    letrec
