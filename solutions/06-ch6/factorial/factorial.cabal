cabal-version: 3.0
name: factorial
version: 0.1.0.0

library
    default-language: Haskell2010
    hs-source-dirs: src

    exposed-modules:
        Factorial
        Factorial.CPSDataStructure
        Factorial.CPSProcedural
        Factorial.Iterative
        Factorial.Registerized

    ghc-options: -Wall

    build-depends:
        base >= 4.20.2 && < 4.21

test-suite spec
    default-language: Haskell2010
    hs-source-dirs: test

    type: exitcode-stdio-1.0
    main-is: Spec.hs

    other-modules:
        Test.FactorialSpec

    ghc-options: -Wall

    build-depends:
        base >= 4.20.2 && < 4.21,
        hspec,
        factorial

    build-tool-depends: hspec-discover:hspec-discover
