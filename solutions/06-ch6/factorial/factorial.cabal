cabal-version: 3.0

name: factorial
version: 0.1.0.0

library
  default-language: Haskell2010
  hs-source-dirs: src

  exposed-modules:
    Factorial
    Factorial.CPSDataStructure
    Factorial.CPSProcedural
    Factorial.Iterative
    Factorial.Registerized
    Factorial.Trampolined

  ghc-options: -Wall

  build-depends:
    base

test-suite tests
  default-language: Haskell2010
  hs-source-dirs: tests

  type: exitcode-stdio-1.0
  main-is: Spec.hs

  other-modules:
    Test.FactorialSpec

  ghc-options: -Wall

  build-depends:
    base,
    hspec,
    factorial

  build-tool-depends:
    hspec-discover:hspec-discover
