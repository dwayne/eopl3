cabal-version: 3.0

name: cps-transformer
version: 0.1.0.0

library
  default-language: Haskell2010
  hs-source-dirs: src

  exposed-modules:
    Interpreter

  other-modules:
    AST
    Env
    Lexer
    Parser

  build-depends:
    base,
    parsec

test-suite tests
  default-language: Haskell2010
  hs-source-dirs: tests

  type: exitcode-stdio-1.0
  main-is: Main.hs

  other-modules:
    Test.Interpreter

  build-depends:
    base,
    hspec,
    cps-transformer
