cabal-version: 2.4

name: exceptions
version: 0.1


library
  default-language: Haskell2010
  hs-source-dirs: src

  exposed-modules:
    AST
    Env
    Interpreter
    Lexer
    Parser

  ghc-options: -Wall

  build-depends:
    base,
    parsec


test-suite tests
  default-language: Haskell2010
  hs-source-dirs: tests

  type: exitcode-stdio-1.0
  main-is: Spec.hs

  other-modules:
    Test.InterpreterSpec
    Test.LexerSpec
    Test.ParserSpec

  ghc-options: -Wall

  build-depends:
    base,
    exceptions,
    hspec,
    parsec

  build-tool-depends:
    hspec-discover:hspec-discover
